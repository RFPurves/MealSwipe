# Server-only keys. Copy this file to .env.local for local development.
YOUTUBE_API_KEY=
OPENAI_API_KEY=

# Optional. The default is a small model that supports Structured Outputs.
OPENAI_RECIPE_MODEL=gpt-4o-mini

# PostgreSQL and Auth.js. Generate AUTH_SECRET with: npx auth secret
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/mealswipe?schema=public
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=http://localhost:3000

# Google OAuth (callback: /api/auth/callback/google)
AUTH_GOOGLE_ID=replace-with-google-client-id
AUTH_GOOGLE_SECRET=replace-with-google-client-secret

# Passwordless email via Resend
AUTH_RESEND_KEY=replace-with-resend-api-key
AUTH_EMAIL_FROM=MealSwipe <login@example.com>

# Optional Microsoft Entra ID
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Local-only passwordless test identities. Never enable in production.
AUTH_DEV_LOGIN=false
